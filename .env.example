EXPO_PUBLIC_TMDB_ACCESS_TOKEN=
# previously-api base URL, e.g. http://localhost:5080 for a local
# `docker compose up` there. The SignalR hub lives at `${this}/hubs/list`.
EXPO_PUBLIC_API_BASE_URL=
# Optional -- crash reporting is a no-op until this is set. See lib/telemetry/sentry.ts.
EXPO_PUBLIC_SENTRY_DSN=
# Source-map upload for release builds only; set these in the EAS build
# environment (SENTRY_AUTH_TOKEN as a secret), not here. See the README.
# SENTRY_ORG=
# SENTRY_PROJECT=
